# Copy to apps/web/.env.local (web) or services/engine/.env (engine). Never commit real values.

# ---- apps/web ----
# Base URL of the engine API. Leave empty to run the web app on contract fixtures (mock layer + "Demo data" badge).
NEXT_PUBLIC_ENGINE_URL=
# ArcGIS Location Platform API key for high-resolution satellite imagery (Esri World Imagery). Public by design:
# scope it to Basemaps only and restrict it to the site referrers. Leave empty to use 10 m Sentinel-2 imagery.
NEXT_PUBLIC_ARCGIS_API_KEY=
# Public site URL, used for metadata and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- services/engine ----
# NASA Earthdata Login credentials (https://urs.earthdata.nasa.gov) for authenticated downloads.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Allowed CORS origins for the engine, comma-separated.
ENGINE_CORS_ORIGINS=http://localhost:3000
