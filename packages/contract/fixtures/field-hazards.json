  "caveats": [
    "Values are for the NASA POWER grid cell (about 50 km across), not the field: frost in a valley bottom or heat on a south slope can differ from the cell average.",
    "Crop-specific heat-stress thresholds are not used: no verified published threshold is in the engine's crop table, so warm days are counted against the record's own 90th percentile."
  ],
  "provenance": [
    {
      "dataset": "NASA POWER daily point data, Agroclimatology community (API v2.10.3)",
      "provider": "NASA Langley Research Center, POWER Project",
      "spatial_resolution": "0.5° × 0.625° (meteorology), 1° × 1° (solar radiation)",
      "temporal_coverage": "2001–2025, daily",
      "access_url": "https://power.larc.nasa.gov/docs/services/api/temporal/daily/",
      "note": "Gridded, model-based reanalysis values for the grid cell containing the field, not field measurements: MERRA-2 meteorology (0.5° × 0.625°) and CERES SYN1deg solar radiation (1° × 1°). Parameters T2M, T2M_MAX, T2M_MIN, T2MDEW, WS2M, PS, ALLSKY_SFC_SW_DWN, PRECTOTCORR, GWETROOT. Daily reference evapotranspiration is FAO-56 Penman-Monteith (eq. 6) with actual vapour pressure from the dew point (eq. 14) and net radiation from eqs. 37–40 using the POWER grid-cell elevation (676 m); annual ET0 is the sum of daily values. Hargreaves (eq. 52) was used on 0 day(s) where Penman-Monteith inputs were missing. Root-zone wetness is the GWETROOT fraction of saturation from the MERRA-2 land model, not a measured soil moisture. Served from the engine's bundled snapshot of this source, fetched 2026-11-14 from power.larc.nasa.gov; no live request was made for it."
    },
    {
      "dataset": "ETCCDI climate change indices (definitions)",
      "provider": "Expert Team on Climate Change Detection and Indices (WMO CCl / WCRP / JCOMM)",
      "spatial_resolution": "Not spatial (index definitions)",
      "temporal_coverage": "Definitions published 2011",
      "access_url": "https://etccdi.pacificclimate.org/list_27_indices.shtml",
      "note": "FD, SU, TXx, R10mm, R20mm, Rx1day and CDD as defined by ETCCDI (Zhang et al. 2011, doi:10.1002/wcc.147), computed on NASA POWER grid-cell daily values. Warm days are a simplified TX90p: threshold = 90th percentile of daily maximum temperature per calendar month over this record. CDD is counted within each calendar year."
    }
