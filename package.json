{
  "name": "travertine",
  "private": true,
  "description": "Travertine: crop-rotation decision support built on Earth observation data.",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "contract:lint": "pnpm --filter @travertine/contract lint",
    "contract:gen": "pnpm --filter @travertine/contract gen"
  }
}
